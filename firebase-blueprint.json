{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and enrollment data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "age": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "uid": { "type": "string" },
        "joinedAt": { "type": "number", "description": "Unix timestamp" },
        "purchased": { "type": "object", "description": "Map of course IDs user has purchased" }
      },
      "required": ["name", "uid"]
    },
    "Course": {
      "title": "Course",
      "description": "Premium LMS course metadata",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnail": { "type": "string", "description": "URL to image" },
        "youtubeIntro": { "type": "string", "description": "YouTube video ID or URL for demo" },
        "youtubePlayMode": { "type": "string", "enum": ["In-App", "Redirect"], "description": "How to play intro video" },
        "discount": { "type": "number", "description": "Optional percentage discount" },
        "linkedNoteId": { "type": "string", "description": "Optional linked study note ID" },
        "linkedTestId": { "type": "string", "description": "Optional linked test series ID" },
        "category": { "type": "string" },
        "tag": { "type": "string", "enum": ["", "NEW", "HOT", "POPULAR"] },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "instructions": { "type": "string" },
        "type": { "type": "string", "enum": ["Free", "Paid"] },
        "price": { "type": "string" },
        "paymentLink": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "category", "thumbnail"]
    },
    "UpcomingCourse": {
      "title": "Upcoming Course",
      "description": "Marketing placeholder for future launches",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnail": { "type": "string" },
        "launchDate": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "thumbnail"]
    },
    "LiveClass": {
      "title": "Live Class",
      "description": "Ongoing or scheduled live session",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "teacher": { "type": "string" },
        "thumbnail": { "type": "string" },
        "mode": { "type": "string", "enum": ["In-App", "YouTube"] },
        "embedUrl": { "type": "string", "description": "YouTube ID or embed link" },
        "youtubeUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["Free", "Paid"] },
        "courseId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "courseId"]
    },
    "Test": {
      "title": "Test Series",
      "description": "Details for a test series",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "type": { "type": "string", "enum": ["Objective", "Subjective"] },
        "status": { "type": "string", "enum": ["Free", "Paid"] },
        "price": { "type": "number" },
        "discount": { "type": "number" },
        "description": { "type": "string" },
        "paymentLink": { "type": "string" },
        "category": { "type": "string" },
        "timePerQuestion": { "type": "string", "description": "Seconds allowed per objective question" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "type", "status"]
    },
    "Question": {
      "title": "Test Question",
      "description": "A single question belonging to a test series",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "options": {
          "type": "object",
          "properties": {
            "A": { "type": "string" },
            "B": { "type": "string" },
            "C": { "type": "string" },
            "D": { "type": "string" }
          }
        },
        "correct": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "createdAt": { "type": "number" }
      },
      "required": ["text"]
    },
    "TestSubmission": {
      "title": "Test Submission",
      "description": "Student attempts and faculty feedback",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "answers": { "type": "object", "description": "Map of QuestionID to student choice/text" },
        "score": { "type": "number" },
        "feedback": { "type": "object", "description": "Map of QuestionID to faculty feedback" },
        "submittedAt": { "type": "number" }
      },
      "required": ["studentId", "answers"]
    },
    "StudyNote": {
      "title": "Study Note",
      "description": "PDF or document study material",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["Free", "Paid"] },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "url"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global app configurations like contact numbers",
      "type": "object",
      "properties": {
        "contacts": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of support contact numbers"
        }
      },
      "required": ["contacts"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profile documents" },
    "/courses/{courseId}": { "schema": "Course", "description": "Monetized LMS courses" },
    "/live/{liveId}": { "schema": "LiveClass", "description": "Live teaching sessions" },
    "/tests/{testId}": { "schema": "Test", "description": "Test series containers" },
    "/test_submissions/{testId}/{userId}": { "schema": "TestSubmission", "description": "Student results per test" },
    "/upcoming_courses/{id}": { "schema": "UpcomingCourse", "description": "Teaser for future launches" },
    "/questions/{testId}/{questionId}": { "schema": "Question", "description": "Questions for tests" },
    "/notes/{noteId}": { "schema": "StudyNote", "description": "PDF resources" },
    "/settings/global": { "schema": "AppSettings", "description": "Global support and app config" }
  }
}
